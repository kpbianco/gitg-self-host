# Host-facing port for the single Grounded Growth application service.
APP_PORT=3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated hostnames or IP addresses used to open the application.
# Add the server's LAN IP before deployment, for example 192.168.1.20.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used only when the database has no users. Remove the password from .env after
# the first successful startup; Grounded Growth never resets an existing user.
APP_BOOTSTRAP_USERNAME=grounded
APP_BOOTSTRAP_PASSWORD=replace-with-a-unique-password

APP_TIME_ZONE=UTC
APP_DEBUG=false

# Leave false for direct local-network HTTP. Set true only when the application
# is served through HTTPS.
APP_SECURE_COOKIES=false
