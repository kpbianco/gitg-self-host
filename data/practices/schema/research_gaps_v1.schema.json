{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grounded-growth.local/schema/practice-research-gaps-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gaps"],
  "properties": {
    "schema_version": {"const": "GG-PRACTICE-RESEARCH-GAPS-1.0"},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "scope",
          "status",
          "priority",
          "blocking_gates",
          "question",
          "current_evidence",
          "resolution_gate"
        ],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^RG-[A-Z0-9-]+-[0-9]{3}$"},
          "scope": {
            "oneOf": [
              {"const": "full_catalog"},
              {
                "type": "string",
                "pattern": "^PRACTICE-[A-Z0-9-]+-[0-9]{2}$"
              }
            ]
          },
          "status": {"enum": ["open", "resolved", "deferred"]},
          "priority": {"type": "string", "minLength": 1},
          "blocking_gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "source_complete",
                "release_candidate",
                "m6b_acceptance",
                "mass_authoring",
                "score_activation"
              ]
            }
          },
          "question": {"type": "string", "minLength": 1},
          "current_evidence": {"type": "string", "minLength": 1},
          "resolution_gate": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
