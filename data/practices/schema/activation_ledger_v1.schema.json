{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grounded-growth.local/schema/score-activation-ledger-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activations"],
  "properties": {
    "schema_version": {"const": "GG-SCORE-ACTIVATION-1.0"},
    "activations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_stable_id",
          "scoring_policy_id",
          "score_active",
          "activation_status",
          "approved_contract",
          "decision_reference",
          "shadow_test_status"
        ],
        "properties": {
          "protocol_stable_id": {"type": "string", "pattern": "^PRACTICE-[A-Z0-9-]+-[0-9]{2}$"},
          "scoring_policy_id": {"type": "string", "pattern": "^SP-[A-Z0-9-]+$"},
          "score_active": {"type": "boolean"},
          "activation_status": {"enum": ["active", "inactive", "qualified_only"]},
          "approved_contract": {"type": ["string", "null"]},
          "decision_reference": {"type": "string", "minLength": 1},
          "shadow_test_status": {
            "enum": [
              "not_started",
              "in_progress",
              "passed",
              "accepted_and_activated",
              "not_applicable"
            ]
          }
        }
      }
    }
  }
}
