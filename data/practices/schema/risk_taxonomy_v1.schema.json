{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grounded-growth.local/schema/protocol-risk-taxonomy-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "risk_classes"],
  "properties": {
    "schema_version": {"const": "GG-PROTOCOL-RISK-1.0"},
    "risk_classes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk_class_id",
          "name",
          "definition",
          "required_safety_sections",
          "required_reviewer_role",
          "specialist_review_required",
          "sensitive_data_limit",
          "pre_review_scoring_ceiling",
          "production_release_conditions"
        ],
        "properties": {
          "risk_class_id": {"enum": ["RISK-LOW", "RISK-MODERATE", "RISK-HIGH"]},
          "name": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "required_safety_sections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "required_reviewer_role": {"type": "string", "minLength": 1},
          "specialist_review_required": {"type": "boolean"},
          "sensitive_data_limit": {"type": "string", "minLength": 1},
          "pre_review_scoring_ceiling": {"enum": ["active_if_separately_approved", "shadow_only", "qualified_only"]},
          "production_release_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
