# One non-interactive shell command per line.
# Sections are cumulative: quick includes contract; full includes quick.

# scope:contract
./scripts/ensure-agent-env.py
.venv/bin/python scripts/verify-manifest.py
.venv/bin/python -m ruff format --check .
.venv/bin/python -m ruff check .
APP_DATA_DIR="$PWD/var/agent-check" DJANGO_SECRET_KEY=agent-check-secret APP_DEBUG=true .venv/bin/python manage.py check
APP_DATA_DIR="$PWD/var/agent-check" DJANGO_SECRET_KEY=agent-check-secret APP_DEBUG=true .venv/bin/python manage.py makemigrations --check --dry-run

# scope:quick
APP_DATA_DIR="$PWD/var/agent-test" .venv/bin/python -m pytest -m "not e2e"

# scope:full
make catalog-governance-audit-check PYTHON=.venv/bin/python
make composite-scoring-catalog-check PYTHON=.venv/bin/python
make composite-scoring-check PYTHON=.venv/bin/python
make applicability-coverage-check PYTHON=.venv/bin/python
make assessment-calibration-check PYTHON=.venv/bin/python
make pilot-check PYTHON=.venv/bin/python
make curriculum-check PYTHON=.venv/bin/python
make competency-evidence-check PYTHON=.venv/bin/python
make context-check PYTHON=.venv/bin/python
make personal-os-check PYTHON=.venv/bin/python
make context-priority-check PYTHON=.venv/bin/python
make m6c-pilot-check PYTHON=.venv/bin/python
make m6d-01-check PYTHON=.venv/bin/python
make m6h-weekly-check PYTHON=.venv/bin/python
make m6h-operations-check PYTHON=.venv/bin/python
